{
  "expo": {
    "name": "ChloroGuard",
    "slug": "chloroguard-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0e1a0f"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e1a0f"
      },
      "package": "com.chloroguard.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ChloroGuard to access your photos to select crop leaf images.",
          "cameraPermission": "Allow ChloroGuard to use the camera to take pictures of crop leaves."
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/6106c584-ebe6-485b-9434-5208fb88da67"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "6106c584-ebe6-485b-9434-5208fb88da67"
      }
    }
  }
}
