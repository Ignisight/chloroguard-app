{
  "expo": {
    "name": "ChloroGuard",
    "slug": "chloroguard-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0e1a0f"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e1a0f"
      },
      "package": "com.chloroguard.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ChloroGuard to access your photos to select crop leaf images.",
          "cameraPermission": "Allow ChloroGuard to use the camera to take pictures of crop leaves."
        }
      ]
    ]
  }
}
